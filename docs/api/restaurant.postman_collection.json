  "item": [
    {
      "name": "01 Kiểm tra tiến trình",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/health/live",
        "description": "Kiểm tra tiến trình — Công khai\n"
      }
    },
    {
      "name": "02 Kiểm tra kết nối database",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/health/ready",
        "description": "Kiểm tra kết nối database — Công khai\n"
      }
    },
    {
      "name": "03 Lấy CSRF token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/csrf",
        "description": "Lấy CSRF token — Công khai\nCookie CSRF được lưu trong cookie jar. Lấy token mới sau khi đăng nhập/đăng xuất hoặc đổi principal. Không dùng chuỗi minh họa làm token thật."
      }
    },
    {
      "name": "04 Hợp đồng OpenAPI",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/openapi.json",
        "description": "Hợp đồng OpenAPI — Công khai\nFile sinh từ catalog test và được đối chiếu route thực. Không chứa secret runtime."
      }
    },
    {
      "name": "05 Đăng nhập nhân viên",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "description": "Đăng nhập nhân viên — Công khai\nSeed local có admin, manager, waiter, kitchen, cashier cùng mật khẩu DEMO_PASSWORD. Cookie ros_staff là HttpOnly; Postman giữ tự động. Mật khẩu ví dụ chỉ dành cho môi trường demo localhost.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"RestaurantDemo!2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 Đọc phiên hiện tại",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/me",
        "description": "Đọc phiên hiện tại — Nhân viên hoặc khách đúng phiên\n"
      }
    },
    {
      "name": "07 Đăng xuất",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/logout",
        "description": "Đăng xuất — Phiên hiện tại\n",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 Đổi mật khẩu",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/change-password",
        "description": "Đổi mật khẩu — Nhân viên\nThu hồi các phiên cũ và cấp lại cookie phiên hiện tại. Mật khẩu mới 12–128 ký tự. Đừng gửi ví dụ này nếu muốn giữ nguyên password demo.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"RestaurantDemo!2026\",\n  \"newPassword\": \"BepNhaNewPass!2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 Danh sách nhân viên",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/staff",
        "description": "Danh sách nhân viên — ADMIN\n"
      }
    },
    {
      "name": "10 Tạo nhân viên",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/staff",
        "description": "Tạo nhân viên — ADMIN\n",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"phucvu02\",\n  \"displayName\": \"Nguyễn Minh Anh\",\n  \"initialPassword\": \"MinhAnhDemo!2026\",\n  \"roles\": [\n    \"WAITER\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11 Sửa/khóa nhân viên",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/staff/{{staffId}}",
        "description": "Sửa/khóa nhân viên — ADMIN\nKhông khóa admin active cuối cùng. Khóa/đổi quyền/reset thu hồi phiên. Ví dụ response rút gọn, response thật còn username/displayName/roles/mustChangePassword.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedVersion\": {{version}},\n  \"displayName\": \"Nguyễn Minh Anh\",\n  \"active\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12 Thay bộ vai trò nhân viên",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/staff/{{staffId}}/roles",
        "description": "Thay bộ vai trò nhân viên — ADMIN\nroles là bộ đầy đủ thay thế, không phải chỉ các role bổ sung.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedVersion\": {{version}},\n  \"roles\": [\n    \"WAITER\",\n    \"CASHIER\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "13 Đặt mật khẩu tạm",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/staff/{{staffId}}/reset-password",
        "description": "Đặt mật khẩu tạm — ADMIN\n",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedVersion\": {{version}},\n  \"temporaryPassword\": \"TemporaryPass!2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "14 Xem thực đơn",
      "request": {
        "method": "GET",
        "header": [
