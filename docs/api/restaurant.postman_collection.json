        "url": "{{baseUrl}}/api/v1/menu-items",
        "description": "Thêm món ăn — MANAGER / ADMIN\n",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"categoryId\": \"20000000-0000-0000-0000-000000000002\",\n  \"code\": \"MON-021\",\n  \"name\": \"Lẩu nấm chay\",\n  \"description\": \"Nấm tươi, rau theo mùa và nước dùng thanh ngọt.\",\n  \"imageUrl\": \"/menu/placeholder.svg\",\n  \"priceVnd\": 159000,\n  \"isActive\": true\n}",
