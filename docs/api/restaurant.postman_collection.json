        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tables/{{tableId}}/qr/rotate",
        "description": "Thay QR cố định khi cần vô hiệu link cũ — MANAGER / ADMIN\nChỉ thay khi cần vô hiệu QR/link đã in. Muốn xem lại QR hiện tại, dùng GET tables/{id}/qr; không gọi rotate mỗi lần xem. URL đầy đủ dùng PublicOrigin. Thay QR không thu hồi guest session đã tham gia đúng lượt; đóng lượt vẫn thu hồi như cũ.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expectedVersion\": {{version}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
