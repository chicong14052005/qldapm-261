      "value": "http://localhost:3000"
    },
    {
      "key": "actor",
      "value": "staff"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "batchId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "visitId",
      "value": ""
    },
    {
      "key": "tableId",
      "value": "40000000-0000-0000-0000-000000000001"
    },
    {
      "key": "menuItemId",
      "value": "30000000-0000-0000-0000-000000000006"
    },
    {
      "key": "categoryId",
      "value": "20000000-0000-0000-0000-000000000002"
    },
    {
      "key": "staffId",
      "value": "10000000-0000-0000-0000-000000000001"
    },
