            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/menu",
        "description": "Xem thực đơn — Công khai\nQuery tùy chọn: categoryId=<UUID>, search=Cơm. Response chỉ danh mục/món active; món hết vẫn hiển thị. Món và danh mục còn createdAt/updatedAt trong response thật."
      }
    },
    {
