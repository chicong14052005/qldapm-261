      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Actor",
            "value": "{{actor}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/manage/menu-items",
        "description": "Xem cả món ẩn — MANAGER / ADMIN\nCùng shape menu, gồm danh mục/món inactive."
      }
    },
    {
      "name": "16 Thêm danh mục",
