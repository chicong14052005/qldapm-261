# Chế độ chạy Frontend: development (phát triển) | production (triển khai)
# Lưu ý: Khi hoàn thiện sản phẩm, đổi lại thành production
NODE_ENV=development

# Cấu hình server Next.js
HOSTNAME=0.0.0.0
PORT=3000

# Tắt thu thập telemetry của Next.js
NEXT_TELEMETRY_DISABLED=1

# Tên hiển thị ứng dụng (tùy chọn)
NEXT_PUBLIC_APP_NAME="Bếp Nhà • Restaurant Ordering"

